---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
---

<!-- z-50 make the panel higher than other float panels -->
<div
  class="relative z-50"
  role="menu"
  tabindex="-1"
  x-data="LightDarkSwitch"
  @mouseleave="hidePanel"
>
  <button aria-label="Light/Dark Mode" role="menuitem" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="scheme-switch" @click="toggleScheme" @mouseenter="showPanel">
    <div class="absolute" :class="{ 'opacity-0': mode !== seq[0] }">
      <Icon name="material-symbols:wb-sunny-outline-rounded" style="font-size: 1.25rem;"></Icon>
    </div>
    <div class="absolute" :class="{ 'opacity-0': mode !== seq[1] }">
      <Icon name="material-symbols:dark-mode-outline-rounded" style="font-size: 1.25rem;"></Icon>
    </div>
    <div class="absolute" :class="{ 'opacity-0': mode !== seq[2] }">
      <Icon name="material-symbols:radio-button-partial-outline" style="font-size: 1.25rem;"></Icon>
    </div>
  </button>

  <div id="light-dark-panel" class="hidden lg:block absolute transition float-panel-closed top-11 -right-2 pt-5">
    <div class="card-base float-panel p-2">
      <button class="flex transition whitespace-nowrap items-center justify-start! w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95 mb-0.5"
        :class="{ 'current-theme-btn': mode === seq[0] }"
        @click="switchScheme(seq[0])"
      >
        <Icon name="material-symbols:wb-sunny-outline-rounded" style="font-size: 1.25rem;" class="mr-3"></Icon>
        {i18n(I18nKey.lightMode)}
      </button>
      <button class="flex transition whitespace-nowrap items-center justify-start! w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95 mb-0.5"
        :class="{ 'current-theme-btn': mode === seq[1] }"
        @click="switchScheme(seq[1])"
      >
        <Icon name="material-symbols:dark-mode-outline-rounded" style="font-size: 1.25rem;" class="mr-3"></Icon>
        {i18n(I18nKey.darkMode)}
      </button>
      <button class="flex transition whitespace-nowrap items-center justify-start! w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95"
        :class="{ 'current-theme-btn': mode === seq[2] }"
        @click="switchScheme(seq[2])"
      >
        <Icon name="material-symbols:radio-button-partial-outline" style="font-size: 1.25rem;" class="mr-3"></Icon>
        {i18n(I18nKey.systemMode)}
      </button>
    </div>
  </div>
</div>