---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
        <!-- 圆形进度条 -->
        <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="40" fill="none" stroke="rgba(0,0,0,0.08)" stroke-width="4"></circle>
            <circle cx="60" cy="60" r="40" fill="none" stroke="var(--primary)" stroke-width="4" stroke-linecap="round" class="progress-ring-circle opacity-80 dark:opacity-90" style="--progress: 0%"></circle>
        </svg>
    </div>
</div>

<style>
.back-to-top-wrapper {
    width: 3.75rem;
    height: 3.75rem;
    position: absolute;
    right: 0;
    top: 0;
    pointer-events: none;
}

.back-to-top-btn {
    color: var(--primary);
    font-size: 2.25rem;
    font-weight: bold;
    border: none;
    position: fixed;
    bottom: 10rem;
    opacity: 1;
    cursor: pointer;
    transform: translateX(5rem);
    pointer-events: auto;

    i {
        font-size: 1.75rem;
    }

    &.hide {
        transform: translateX(5rem) scale(0.9);
        opacity: 0;
        pointer-events: none;
    }

    &:active {
        transform: translateX(5rem) scale(0.9);
    }
}

/* 圆形进度条样式 */

  .progress-ring-circle {
    stroke-dasharray: 251.33; /* 2 * π * 40 */
    stroke-dashoffset: calc(251.33 * (1 - var(--progress, 0%) / 100%));
    transition: stroke-dashoffset 0.3s ease;
  }

  /* 暗色主题 */
  /* :global(.dark) .progress-ring-bg {
    stroke: rgba(255, 255, 255, 0.1);
  } */
</style>

<script is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}


const btn = document.querySelector('.back-to-top-btn');
const progressCircle = document.querySelector('.progress-ring-circle');

const update = () => {
    const scrollTop = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const percent = maxScroll ? (scrollTop / maxScroll) * 100 : 0;

    if (progressCircle) {
        progressCircle.style.setProperty('--progress', percent + '%');
    }
    if (btn) {
        if (scrollTop > 300) {
            btn.classList.remove('hide');
        } else {
            btn.classList.add('hide');
        }
    }
};

window.addEventListener('scroll', update);
update();
</script>
