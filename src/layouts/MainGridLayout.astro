---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Background from "@components/misc/Background.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
// import { Icon } from "astro-icon/components";
// import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TypewriterText from "../components/TypewriterText.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
// const hasBannerCredit =
// 	siteConfig.banner.enable && siteConfig.banner.credit.enable;
// const hasBannerLink = !!siteConfig.banner.credit.url;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const bannertextEnabled = siteConfig.bannertext.enable;
const showBannerText = bannertextEnabled && isHomePage;

const mainPanelTop = /*siteConfig.banner.enable*/ siteConfig.bannertext.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<Background></Background>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-(--page-width) px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{/*siteConfig.banner.enable*/ bannertextEnabled && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    {/* <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper> */}
    <div id="banner" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}></div>

    <!-- Banner text overlay -->
    {bannertextEnabled && (
        <div id="banner-text" class={`banner-text-overlay absolute inset-0 z-20 flex flex-col items-center justify-center text-center mx-auto ${!showBannerText ? 'hidden' : ''}`}>
            {siteConfig.bannertext.title && (
                <h1 class="banner-title font-bold text-white">
                    {siteConfig.bannertext.title}
                </h1>
            )}
            {siteConfig.bannertext.subtitle && (
                <h2 class="banner-subtitle  text-white text-opacity-90">
                    {siteConfig.bannertext.typewriter ? (
                        <TypewriterText
                            text={siteConfig.bannertext.subtitle}
                            speed={siteConfig.bannertext.typewriter.speed}
                            deleteSpeed={siteConfig.bannertext.typewriter.deleteSpeed}
                            pauseTime={siteConfig.bannertext.typewriter.pauseTime}
                        />
                    ) : (
                        Array.isArray(siteConfig.bannertext.subtitle)
                            ? siteConfig.bannertext.subtitle[0]
                            : siteConfig.bannertext.subtitle
                    )}
                </h2>
            )}
        </div>
    )}
</div>
}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {/*hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa7-solid:arrow-up-right-from-square">
                </Icon>
            </a>*/}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-(--page-width) mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-(--toc-width) w-(--toc-width) items-center",
            {"toc-hide": /*siteConfig.banner.enable*/ bannertextEnabled}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-(--toc-width) h-[calc(100vh-20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>

<style>
.banner-title {
    animation: fade-in-up 500ms ease-out;
}

.banner-subtitle {
    animation: fade-in-up 500ms ease-out 300ms both;
    min-height: 1.5em;
}


/* 移动端小屏 (320px - 479px) */
@media (max-width: 479px) {
    .banner-text-overlay {
        max-width: 95%;
        padding: 1rem;
    }
    .banner-title {
        font-size: 3.2rem;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .banner-subtitle {
        font-size: 1rem;
        line-height: 1.3;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
    }
}

/* 移动端大屏 (480px - 767px) */
@media (min-width: 480px) and (max-width: 767px) {
    .banner-text-overlay {
        max-width: 90%;
        padding: 1.5rem;
    }
    .banner-title {
        font-size: 3.8rem;
        line-height: 1.1;
        margin-bottom: 0.75rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .banner-subtitle {
        font-size: 1.125rem;
        line-height: 1.4;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
    }
}

/* 平板设备 (768px - 1279px) */
@media (min-width: 768px) and (max-width: 1279px) {
    .banner-text-overlay {
        max-width: 85%;
        padding: 2rem;
    }
    .banner-title {
        font-size: 4rem;
        line-height: 1.1;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .banner-subtitle {
        font-size: 1.5rem;
        line-height: 1.4;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
    }
}


/* 桌面端 (1280px+) */
@media (min-width: 1280px) {
    .banner-text-overlay {
        max-width: 75%;
        padding: 2rem;
    }
    .banner-title {
        font-size: 6rem;
        line-height: 1;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .banner-subtitle {
        font-size: 1.875rem;
        line-height: 1.2;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
    }
}

/* 极小高度屏幕 (高度 ≤ 500px) */
@media (max-height: 500px) {
    .banner-text-overlay {
        padding: 1rem;
    }
    .banner-title {
        font-size: 2.8rem;
        line-height: 1.1;
        margin-bottom: 0.5rem;
    }
    .banner-subtitle {
        font-size: 0.9rem;
        line-height: 1.2;
    }
}

/* 小高度屏幕 (高度 501px - 600px) */
@media (min-height: 501px) and (max-height: 600px) {
    .banner-text-overlay {
        padding: 1.5rem;
    }
    .banner-title {
        font-size: 3.2rem;
        line-height: 1.1;
        margin-bottom: 0.75rem;
    }
    .banner-subtitle {
        font-size: 1rem;
        line-height: 1.3;
    }
}

/* 中等高度屏幕 (高度 601px - 700px) */
@media (min-height: 601px) and (max-height: 700px) {
    .banner-text-overlay {
        padding: 2rem;
    }
    .banner-title {
        font-size: 3.8rem;
        line-height: 1.1;
        margin-bottom: 1rem;
    }
    .banner-subtitle {
        font-size: 1.125rem;
        line-height: 1.4;
    }
}

/* 横屏模式且高度 ≤ 500px */
@media (orientation: landscape) and (max-height: 500px) {
    .banner-text-overlay {
        padding: 1rem 2rem;
    }
    .banner-title {
        font-size: 2.8rem;
        line-height: 1.1;
        margin-bottom: 0.5rem;
    }
    .banner-subtitle {
        font-size: 1rem;
        line-height: 1.2;
    }
}
</style>